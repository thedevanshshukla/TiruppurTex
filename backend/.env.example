# MongoDB Connection (e.g. MongoDB Atlas or local MongoDB)
# Leave empty to run with zero-config in-memory embedded engine
MONGODB_URI=
DB_NAME=tiruppur_tex

# JWT Secret
JWT_SECRET=tiruppur-knitwear-secret-key-2026-auth-jwt

# Optional AI LLM API Keys (Falls back automatically to local Tiruppur textile domain lexicon)
GEMINI_API_KEY=
OPENAI_API_KEY=

ENVIRONMENT=production

